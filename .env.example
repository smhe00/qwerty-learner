# Frontend build configuration.
# This is a public endpoint, not a secret. Both production frontends use the
# same EdgeOne API so cloud accounts and snapshots are shared.
VITE_QWERTY_SYNC_BASE_URL=https://qwerty-plus.edgeone.dev

# EdgeOne Makers Cloud Function runtime configuration.
# No application secret is required by the V1 single-active-session design.

SESSION_TTL_SECONDS=604800
MAX_SYNC_BYTES=4194304
BLOB_STORE_NAME=qwerty-data
# Exact browser Origin allowlist. GitHub Pages Origin never includes the repo path.
CORS_ORIGIN=https://qwerty-plus.edgeone.dev,https://smhe00.github.io
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
