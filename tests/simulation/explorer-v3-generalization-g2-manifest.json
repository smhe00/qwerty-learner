{
  "schema": "explorer-v3-generalization-holdout-g2-v1",
  "frozenAt": "2026-10-10",
  "protocol": "New independent holdout. All 16 source mutants frozen before first CI. Existing detection tests only, no post-run adjustments. Killed=compiled mutant rejected by a test assertion; survived=mutant passes; invalid=build/run failure not due to a test assertion. No minimum kill rate.",
  "detectorSuites": {
    "fsrs": "tests/fsrs/g5-active-scheduler.test.ts",
    "rating": "tests/learn/acquisition-domain.test.ts",
    "ownership": "tests/review/async-ownership.test.ts",
    "recovery": "tests/learn/scaffold-recovery.test.ts",
    "sync": "tests/learn/daily-session.test.ts"
  },
  "mutations": [
    {
      "id": "fsrs-chronology-reversed",
      "category": "fsrs",
      "source": "src/review/fsrs/active.ts",
      "from": "[...records].sort(compareRecordOrder)",
      "to": "[...records].sort((left, right) => compareRecordOrder(right, left))"
    },
    {
      "id": "fsrs-hard-rating-treated-as-good",
      "category": "fsrs",
      "source": "src/review/fsrs/active.ts",
      "from": "hard: Rating.Hard,",
      "to": "hard: Rating.Good,"
    },
    {
      "id": "fsrs-initial-due-delayed-extra-day",
      "category": "fsrs",
      "source": "src/review/fsrs/active.ts",
      "from": "? firstAdmission.timeStamp + DAY_SECONDS",
      "to": "? firstAdmission.timeStamp + 2 * DAY_SECONDS"
    },
    {
      "id": "fsrs-clean-streak-double-increment",
      "category": "fsrs",
      "source": "src/review/fsrs/active.ts",
      "from": "cleanStreak += 1",
      "to": "cleanStreak += 2"
    },
    {
      "id": "review-ineligible-rating-replayed",
      "category": "rating",
