    },
    {
      "id": "review-legacy-clean-accepted",
      "category": "rating",
      "source": "src/review/rebuild.ts",
      "from": "return record.wrongCount > 0 ? inferLegacyReviewOutcome(record.wrongCount) : undefined",
      "to": "return record.wrongCount > 0 ? inferLegacyReviewOutcome(record.wrongCount) : 'good'"
    },
    {
      "id": "owner-stale-result-accepted",
      "category": "ownership",
      "source": "src/learn/async-ownership.ts",
      "from": "active && generation === claimGeneration",
      "to": "active"
    },
    {
      "id": "owner-deactivate-does-not-disable",
      "category": "ownership",
      "source": "src/learn/async-ownership.ts",
      "from": "deactivate() {\n      active = false",
      "to": "deactivate() {\n      active = true"
    },
    {
      "id": "owner-old-invalidates-new",
      "category": "ownership",
      "source": "src/learn/async-ownership.ts",
      "from": "if (generation === claimGeneration) {",
      "to": "if (true) {"
    },
    {
      "id": "recovery-independent-training-eligible",
      "category": "recovery",
      "source": "src/learn/recovery-window.ts",
      "from": "if (state.phase !== 'supported') return false",
      "to": "if (state.phase === 'supported') return false"
    },
    {
      "id": "recovery-window-only-high-strain",
      "category": "recovery",
      "source": "src/learn/recovery-window.ts",
      "from": "(tier === 'elevated' || tier === 'recovery')",
      "to": "tier === 'recovery'"
    },
    {
      "id": "recovery-window-unbounded-lookahead",
      "category": "recovery",
      "source": "src/learn/recovery-window.ts",
      "from": "learnRecoveryWindowPolicy.maxLookaheadItems,",
      "to": "10000,"
    },
    {
      "id": "sync-divergence-suppressed",
      "category": "sync",
      "source": "src/sync/state.ts",
      "from": "const diverged = localDirty && remoteChanged",
      "to": "const diverged = false"
    },
    {
      "id": "sync-divergence-auto-uploads",
      "category": "sync",
      "source": "src/sync/state.ts",
      "from": "if (assessment.diverged) return 'diverged'",
      "to": "if (assessment.diverged) return 'upload'"
    },
    {
      "id": "sync-remote-ahead-auto-uploads",
      "category": "sync",
      "source": "src/sync/state.ts",
      "from": "if (assessment.remoteChanged) return 'remote-ahead'",
      "to": "if (assessment.remoteChanged) return 'upload'"
    }
  ]
}
