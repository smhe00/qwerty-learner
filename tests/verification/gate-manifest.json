{
  "version": 1,
  "levels": {
    "L0": "product-contract",
    "L1": "domain-formal-simulation",
    "L2": "integration-browser",
    "L3": "regression"
  },
  "gates": [
    {
      "id": "review",
      "workflow": ".github/workflows/review-gate.yml",
      "owner": "learn-review-integration"
    },
    {
      "id": "fsrs",
      "workflow": ".github/workflows/fsrs-phase-g-gate.yml",
      "owner": "fsrs"
    },
    {
      "id": "tla",
      "workflow": ".github/workflows/tla-gate.yml",
      "owner": "formal-models"
    },
    {
      "id": "achievement",
      "workflow": ".github/workflows/achievement-gate.yml",
      "owner": "achievement"
    },
    {
      "id": "dictionary",
      "workflow": ".github/workflows/dictionary-gate.yml",
      "owner": "dictionary"
    },
    {
      "id": "cloud",
      "workflow": ".github/workflows/cloud-sync.yml",
      "owner": "cloud-sync"
    }
  ],
  "contracts": [
    {
      "id": "LEARN-DAILY-001",
      "title": "DailySession is the product-level Learn session",
      "level": "L0",
      "owner": "src/learn/daily-session.ts",
      "gate": "review",
      "tests": [
        "tests/learn/daily-session.test.ts",
        "tests/e2e/learn-live-stats.spec.ts"
      ]
    },
    {
      "id": "LEARN-PROGRESS-001",
      "title": "Daily progress advances only from final independent-clean logical-word completion",
      "level": "L0",
      "owner": "src/learn/daily-session.ts",
      "gate": "review",
      "tests": [
        "tests/learn/daily-session.test.ts",
        "tests/e2e/learn-live-stats.spec.ts"
      ]
    },
    {
      "id": "LEARN-BLOCK-001",
      "title": "Block completion enters durable Pause and does not imply Daily completion",
      "level": "L0",
      "owner": "src/learn/settlement.ts",
      "gate": "review",
      "tests": [
        "tests/e2e/review-flow.spec.ts",
        "tests/simulation/persistence-race.test.ts"
      ]
    },
    {
      "id": "LEARN-RECOVERY-001",
      "title": "Reload resumes the current logical word without replaying completed words",
      "level": "L0",
      "owner": "src/store/reviewInfoAtom.ts",
      "gate": "review",
      "tests": [
        "tests/e2e/learn-recovery-flow.spec.ts",
        "tests/e2e/browser-stateful-fuzz.spec.ts"
      ]
    },
    {
      "id": "LEARN-HINT-001",
      "title": "Hint escalation and persisted hint state are monotonic",
      "level": "L1",
      "owner": "src/review/hint.ts",
      "gate": "review",
      "tests": [
        "tests/review/hint.test.ts",
        "tests/e2e/review-flow.spec.ts"
      ]
    },
    {
      "id": "LEARN-QUOTA-001",
      "title": "Explicit daily new-word target is not silently reduced by workload diagnostics",
      "level": "L0",
      "owner": "src/learn/quota.ts",
      "gate": "review",
      "tests": [
        "tests/learn/quota-strain.test.ts",
        "tests/e2e/learn-acquisition-flow.spec.ts",
        "tests/simulation/system-driver.test.ts"
      ]
    },
    {
      "id": "FSRS-SCHED-001",
      "title": "FSRS-6 active scheduler contract and pinned package behavior",
      "level": "L1",
      "owner": "src/review/fsrs",
      "gate": "fsrs",
      "tests": [
        "tests/fsrs/g5-active-scheduler.test.ts",
        "tests/fsrs/g1-shadow-replay.test.ts"
      ]
    },
    {
      "id": "LEARN-FORMAL-001",
      "title": "Core Learn lifecycle invariants have TLC counterexample coverage",
      "level": "L1",
      "owner": "formal/learn",
      "gate": "tla",
      "tests": [
        "tests/formal/tla-trace-bridge.test.ts"
      ]
    },
    {
      "id": "AUDIO-001",
      "title": "Spelling completion never triggers post-success auto pronunciation",
      "level": "L0",
      "owner": "src/resources/soundResource.ts",
      "gate": "review",
      "tests": [
        "tests/review/typing-audio-formal.test.ts",
        "tests/e2e/typing-lifecycle.spec.ts"
      ]
    },
    {
      "id": "SYNC-LEARN-001",
      "title": "Daily completion sync uploads only when local is safely ahead",
      "level": "L0",
      "owner": "src/sync/auto.ts",
      "gate": "cloud",
      "tests": [
        "tests/cloud/backend-core.test.mjs",
        "tests/e2e/cloud-sync-live.spec.ts"
      ]
    },
    {
      "id": "ACHIEVEMENT-001",
      "title": "Achievement sidecars never block Learn durable settlement",
      "level": "L1",
      "owner": "src/achievement",
      "gate": "achievement",
      "tests": [
        "tests/achievement/session.test.ts",
        "tests/achievement/domain.test.ts"
      ]
    }
  ],
  "cleanup": {
    "oversizedSuites": [
      "tests/review/domain.test.ts"
    ],
    "duplicateExecutionCandidates": [
      {
        "tests": [
          "tests/fsrs/g2-live-shadow.test.ts",
          "tests/fsrs/g3-analysis.test.ts",
          "tests/fsrs/g5-active-scheduler.test.ts"
        ],
        "canonicalGate": "fsrs",
        "duplicateGate": "review"
      }
    ],
    "legacyWorkflowCandidates": [
      ".github/workflows/e2e.yml"
    ]
  }
}
