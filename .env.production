# Public production API endpoint shared by the EdgeOne and GitHub Pages frontends.
# Do not place secrets in VITE_* variables; Vite exposes them to the browser.
VITE_QWERTY_SYNC_BASE_URL=https://qwerty-plus.edgeone.dev

# Supervised one-account Maker S1 + V4 migration.
# These Vite flags ONLY expose the pre-mount UI, not backend V4 write access.
# Server STILL requires exact immutable userId in S2_SYNC_WRITE_ACCOUNT_IDS.
VITE_S1_ENABLE_EXPLICIT_V4_MIGRATION=true
VITE_S2_ENABLE_UNIFIED_SYNC=true
