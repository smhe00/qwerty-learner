# Every EdgeOne deployment uses its own same-origin /api endpoint.
# Never let main EdgeOne test traffic write to production account/Blob storage.
# GitHub Pages is cloud-disabled separately in src/sync/api.ts.
VITE_QWERTY_SYNC_BASE_URL=

# Only V4 cloud backups are supported. The local S1 workspace setup guard
# remains enabled for clients that do not yet have isolated workspaces.
VITE_S1_ENABLE_EXPLICIT_V4_MIGRATION=true
VITE_S2_ENABLE_UNIFIED_SYNC=true
